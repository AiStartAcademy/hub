# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Alternate dist dirs (NEXT_DIST_DIR in next.config.ts). Keep the verification
# dev server and the verification build in SEPARATE dirs — a build that wipes the
# dir a running `next dev` is using corrupts its Turbopack cache.
/.next-verify/
/.next-build/
/.next-newsletter/
/out/

# production
/build

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets never committed; .env.example IS the committed template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma client is generated at build time (prisma/schema.prisma -> generator output).
# Never commit it: merge conflicts corrupt the generated package.json and break `prisma generate`.
/src/generated/client
*.db
prisma/dev.db
prisma/migrations

public/uploads/*

tree.txt

/bruno

first-lessons-data.json

lms_db_data

certificate-template-prompt.md
# local-only Docker override (never commit)
docker-compose.override.yml
# macOS. "Icon\r" is the custom-folder-icon artifact Finder leaves behind; the
# trailing carriage return is part of the filename, which is why the pattern
# needs the `?` wildcard. Setting a custom icon on the repo folder sprays these
# into every subdirectory including .git/ — and because git reads every file
# under .git/refs/ as a ref, they show up as `fatal: bad object refs/Icon?` and
# break `git fetch` entirely. Ignore them so `git add -A` can never commit one.
Icon?
.DS_Store
._*
.Spotlight-V100
.Trashes

graphify-out/

# local-only scratch: git worktrees, throwaway DBs/caches, one-off repro scripts
/.worktrees/
/local/
/repro.mjs
bun.lock
.claude/settings.local.json
