  type   String // BLOG | LANDING
  slug   String @unique // "how-to-learn-ai" | "ai-bootcamp-san-francisco"
  url    String @unique // "/blog/how-to-learn-ai/" | "/ai-bootcamp-san-francisco/"
  status String @default("DRAFT") // DRAFT | GENERATING | READY_FOR_REVIEW | IN_REVIEW | PUBLISHED | DISABLED | ARCHIVED

  // Roadmap / SEO (from the CSV — shared by both types)
  priority          String? // P1..P3
  funnelStage       String // Awareness | Consideration | Conversion
  segment           String? // beginners | professionals | founders | ...
  primaryKeyword    String
  secondaryKeywords String?
  metaTitle         String
  metaDescription   String
  h1                String
  sectionsPlan      String? // CSV "Recommended H2 / Sections"
  schemaTypes       String  @default("Article; FAQPage") // "Article; FAQPage" | "Course; LocalBusiness; FAQPage"
  template          String  @default("default") // render template id (currently only "default")
  indexable         Boolean @default(true) // index vs noindex (paid-only LPs)
  guardrails        String? // CSV Notes — honored at review; blocks publish until acknowledged

  // Generated content (JSON strings the generator turns into HTML)
  answerBlock     String? // 40–60w GEO/AEO extract
  bodyHtml        String? // long-form (blog) — Tiptap-compatible
  sections        String? // JSON: landing beats [{kind, heading, body, ...}]
  faq             String? // JSON: [{q,a}]
  sources         String? // JSON: [{title,url}] verified
  videos          String? // JSON: [{title,youtubeId}]
  ctas            String? // JSON: [{position,label,href,gaEvent,gaSection}]
  ogImageUrl      String? // GCS 1200×630
  inlineImages    String? // JSON: [{url,alt}]
