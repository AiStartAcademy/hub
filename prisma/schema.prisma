generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.md"
  theme    = "default"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth Models ───────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("STUDENT") // STUDENT | TEAM_MEMBER | INSTRUCTOR | ADMIN — legacy primary role, kept for display/back-compat
  roles         String    @default("[]") // JSON string[] of the same enum — the source of truth once populated; see src/lib/roles.ts
  timezone      String    @default("UTC")
  birthday      String? // ISO YYYY-MM-DD date-only string; timezone-safe
  /// Controls whether this closer participates in browser-softphone simulring.
  isAvailableForCalls Boolean @default(false)
  bio           String? // User bio with rich text formatting
  attribution   String? // JSON: captured UTM params + ad click ids at signup (first-touch)
  stripeCustomerId String? @unique // Stripe Customer id (paid enrollments)
  // Part B of the Recording and Media Release — OPTIONAL promotional use of likeness.
  // null = never granted or since withdrawn, i.e. do-not-publish. Consent to *record*
  // (Part A, required) is the UserConsent row for docKey "recording"; these are
  // deliberately separate so declining marketing use never blocks enrollment.
  marketingReleaseAt DateTime?
  rocketchatId       String?   @unique
  rocketchatUsername String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Public profile (Humans/Mentors/Instructors) — see docs/features/HUMANS.md
  isMentor          Boolean @default(false)
  profileVisibility String  @default("PRIVATE") // PRIVATE | PUBLIC | UNLISTED
  slug              String? @unique // public /humans/{slug}
  // Long-lived token for /instructor-schedule/{token} — the instructor's own view of
  // every cohort they're teaching. Cross-cohort grain, unlike CohortInstructor.responseToken.
  scheduleToken     String? @unique
  /// Long-lived token for /book/{token} — the closer's public lead-booking page.
  bookingToken      String? @unique
  headline          String? // one-line title, e.g. "Founder & CEO, AI Automation Agency"
  location           String?
  languages          String? // comma-separated
  socialLinks        String? // JSON {linkedin,youtube,x,site}
  expertiseTags      String? // comma-separated, free-text (mirrors Cohort.tools)

  accounts           Account[]
  sessions           Session[]
  enrollments        Enrollment[]
  payments           Payment[]
  programEnrollments ProgramEnrollment[]
  groupMembers       GroupMember[]
  taughtCohorts      Cohort[]               @relation("CohortInstructors")
  submissions        AssessmentSubmission[]
  lessonProgress     LessonProgress[]
  reviews            CourseReview[]
  instructorSlots    InstructorSlot[]       @relation("InstructorSlots")
  studentBookings    OneOnOneBooking[]      @relation("StudentBookings")
  instructorBookings OneOnOneBooking[]      @relation("InstructorBookings")
  quizSubmissions    QuizSubmission[]
  programAccess      ProgramAccess[]
  certificates       Certificate[]
  memberships        Membership[]
  ownedCoupons       Coupon[]     @relation("CouponOwner")
  portfolioItems     PortfolioItem[]
  profileVideos      ProfileVideo[]
  testimonials       Testimonial[]
  cohortInstructorRecords CohortInstructor[] @relation("CohortInstructorRecords")
  ledSessions             CohortSession[]    @relation("SessionInstructor")
  podMembers              PodMember[]
  coachedPods             Pod[]                  @relation("PodCoach")
  milestoneAchievements   MilestoneAchievement[]
  verifiedAchievements    MilestoneAchievement[] @relation("MilestoneVerifier")
  consents                UserConsent[]
  closerSlots             CloserSlot[]
  leadSeries              SessionSeries[]        @relation("SeriesInstructor")
  ledSeriesOccurrences    SeriesOccurrence[]     @relation("SeriesOccurrenceInstructor")
}

// ─── Student Consent ────────────────────────────────────────────────
// Append-only record of which legal document, at which version, a user accepted.
// A version bump writes a NEW row rather than mutating the old one, so we can always
// reproduce what someone agreed to and when. Document text + versions live in
// src/lib/legalDocs.ts and src/content/legal/*.md.
//
// Paid students are enrolled by the Stripe webhook with no browser present, so consent
// cannot be collected at enrollment — it is enforced at access time in checkProgramAccess().
model UserConsent {
  id         String   @id @default(cuid())
  userId     String
  docKey     String // tos | privacy | conduct | recording | ai-ip | waiver — see LegalDocKey
  version    String // the LEGAL_DOCS version string in force when accepted
  acceptedAt DateTime @default(now())
  ip         String? // first x-forwarded-for hop, "unknown" when absent
  userAgent  String?
  cohortId   String? // which enrollment prompted this acceptance, for context

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, docKey, version])
  @@index([userId])
  @@index([docKey, version])
}

model PortfolioItem {
  id        String   @id @default(cuid())
  userId    String
  title     String
  url       String
  thumbnail String?
  outcome   String? // 1-line outcome, e.g. "Built a VAPI voice agent that booked 200 calls/mo"
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProfileVideo {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Testimonial {
  id           String   @id @default(cuid())
  userId       String
  quote        String
  authorName   String
  authorRole   String?
  authorAvatar String?
  source       String   @default("manual") // manual | review
  reviewId     String? // CourseReview.id, when source = "review"
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── LMS Models ────────────────────────────────────────────────────
model Cohort {
  id            String    @id @default(cuid())
  pods          Pod[]
  title         String
  slug          String?   @unique // clean public URL, auto-generated from title (e.g. "ai-automation-agency-bootcamp")
  description   String?
  cover         String? // URL to cover image
  status        String    @default("DRAFT") // DRAFT | ENROLLMENT | IN_PROGRESS | COMPLETE | ARCHIVED
  deliveryMode  String    @default("ONLINE") // INPERSON | ONLINE | HYBRID
  location      String?
  zoomLink      String?
  zoomMeetingId String?  // Unique identifier for Zoom recurring meeting
  startDate     DateTime?
  endDate       DateTime?
  startTime     String?   // e.g. "10:00am" — cohort-level daily start (sessions may override)
  endTime       String?   // e.g. "5:00pm"
  timezone      String    @default("PT")
  tools         String?   // free-text tag list, comma-separated (e.g. "Claude Code, n8n, VAPI")
  certificate   Boolean   @default(true) // whether this cohort awards a completion certificate
  leadMagnet    Boolean   @default(false) // free lead-magnet event (e.g. Q&A): email-capture register, no checkout
  leadMagnetCta String?   // optional CTA label for the lead magnet (default "Save your spot — free")
  memberEventType String? // null = not mirrored into Member Calls; otherwise a MemberEvent type such as WEEKLY_QA — the cohort's sessions then show up on /members/calls
  rawProgramId  String?   @unique
  rawProgram    Program?  @relation("CohortRawProgram", fields: [rawProgramId], references: [id], onDelete: SetNull)
  rocketchatGroupId  String?   @unique
  // The RC group NAME as created. Persisted so renaming the cohort does not
  // re-derive a different channel and orphan the existing chat history.
  rocketchatChannelName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt


  programs              Program[]
  sessions              CohortSession[]
  enrollments           Enrollment[]
  groups                Group[]
  instructors           User[]                 @relation("CohortInstructors")
  submissions           AssessmentSubmission[]
  lessonProgress        LessonProgress[]
  onboardingTagMappings OnboardingTagCohort[]
  onboardingResponses   OnboardingResponse[]
  learningPaths         LearningPath[]
  materials             CohortMaterial[]       // Opposite relation field for CohortMaterial
  certificates          Certificate[]
  payments              Payment[]
  instructorRecords     CohortInstructor[]
  instructorOutreaches  InstructorOutreach[]
  seriesLinks           SessionSeriesCohort[]
}

model CohortMaterial {
  id        String   @id @default(cuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  
  title     String
  type      String   
  url       String   
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cohortId])
}

model Group {
  id            String   @id @default(cuid())
  cohortId      String
  name          String
  inPerson      Boolean  @default(false)
  price         Float    @default(0)
  seats         Int      @default(50)
  allowOneOnOne Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cohort   Cohort            @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  slots    InstructorSlot[]
  bookings OneOnOneBooking[]
  payments Payment[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model CohortSession {
  id               String   @id @default(cuid())
  cohortId         String
  title            String
  description      String?
  date             DateTime
  startTime        String // e.g. "10:00 AM"
  endTime          String // e.g. "12:00 PM"
  timezone         String   @default("PST")
  status           String   @default("upcoming") // upcoming | live | completed
  meetingLink      String?
  // Set when this session's join link was borrowed from another cohort's session
  // (admin "From another cohort"). meetingLink still holds the resolved URL, so a
  // SetNull here only drops the provenance, never the link itself.
  linkedSessionId  String?
  recordingLink    String?
  zoomOccurrenceId String?
  order            Int      @default(0)
  instructorId     String? // optional lead instructor for this session
  // Google Calendar mirror of this session (created once instructors confirm) —
  // same field trio as VenueEvent, see src/lib/googleCalendar.ts.
  gcalEventId      String?
  gcalSyncError    String?
  gcalSyncedAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cohort        Cohort          @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  linkedSession CohortSession?  @relation("SessionLink", fields: [linkedSessionId], references: [id], onDelete: SetNull)
  linkedFrom    CohortSession[] @relation("SessionLink")
  instructor User?      @relation("SessionInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  resources  Resource[]
  instructorResponses CohortSessionInstructorResponse[]
  assignments         SessionAssignment[]

  // Zoom's occurrence_id is the occurrence's start-time epoch timestamp — NOT globally
  // unique across different meetings that happen to share a session start moment (this
  // was previously a bare @unique on zoomOccurrenceId, which let two cohorts' meetings
  // with identical schedules silently steal each other's session row on sync).
  @@unique([cohortId, zoomOccurrenceId])
  @@index([linkedSessionId])
}

// ─── Shared Session Series ──────────────────────────────────────────
// A recurring session that is NOT owned by a single cohort — the daily check-in
// call that serves every currently-running day cohort at once, on one Zoom link.
//
// Deliberately a separate table from CohortSession rather than a many-to-many on it:
// syncCohortSessions() deletes any cohort session row whose Zoom occurrence has gone
// and re-derives title/order from list index, so a shared row living there would be
// destroyed on the next per-cohort sync. Keeping series occurrences in their own table
// leaves that path, and the Zoom recording webhook's cohort lookup, untouched.
//
// Splitting as headcount grows is an attachment move, not a migration: create a second
// series, point the cohort's SessionSeriesCohort row at it, assign the other instructor.
model SessionSeries {
  id            String    @id @default(cuid())
  title         String
  kind          String    @default("CHECKIN") // CHECKIN | ONBOARDING
  description   String?
  status        String    @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED
  zoomLink      String?
  zoomMeetingId String?   @unique
  days          String // CSV of SUN..SAT — same vocabulary as cohort_create's zoomDays
  startTime     String // wall clock in `timezone`, e.g. "11:00 AM"
  endTime       String
  timezone      String    @default("America/Los_Angeles")
  startDate     DateTime
  // null = rolling. Zoom needs a bounded occurrence count, so the Zoom series is
  // provisioned a horizon at a time and re-extended by the same job that rolls cohorts.
  endDate       DateTime?
  instructorId  String? // default lead; a per-occurrence instructor overrides it
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  instructor  User?                 @relation("SeriesInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  cohorts     SessionSeriesCohort[]
  occurrences SeriesOccurrence[]

  @@index([status])
}

// Which cohorts a series serves. One row per (series, cohort) attachment.
model SessionSeriesCohort {
  seriesId  String
  cohortId  String
  createdAt DateTime @default(now())

  series SessionSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  cohort Cohort        @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@id([seriesId, cohortId])
  @@index([cohortId])
}

model SeriesOccurrence {
  id               String    @id @default(cuid())
  seriesId         String
  title            String
  date             DateTime
  startTime        String // UTC ISO, same convention as CohortSession
  endTime          String
  timezone         String    @default("America/Los_Angeles")
  status           String    @default("upcoming") // upcoming | live | completed
  meetingLink      String?
  recordingLink    String?
  zoomOccurrenceId String?
  instructorId     String? // overrides SessionSeries.instructorId for this date
  gcalEventId      String?
  gcalSyncError    String?
  gcalSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  series     SessionSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  instructor User?         @relation("SeriesOccurrenceInstructor", fields: [instructorId], references: [id], onDelete: SetNull)

  // Zoom's occurrence_id is the occurrence's start-time epoch and is NOT globally
  // unique — same trap CohortSession hit. Scope it to the series.
  @@unique([seriesId, zoomOccurrenceId])
  @@index([seriesId, date])
}

model Resource {
  id        String   @id @default(cuid())
  sessionId String
  title     String
  type      String // pdf | video | link | document
  url       String
  createdAt DateTime @default(now())

  session CohortSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ─── Instructor Participation & Outreach ──────────────────────────
// Explicit cohort↔instructor record carrying confirmation state. Coexists with the
// implicit "CohortInstructors" m2m (which stays the read source for public pages);
// rows are kept in sync by syncCohortInstructors() in src/lib/instructorParticipation.ts.
model CohortInstructor {
  id            String    @id @default(cuid())
  cohortId      String
  instructorId  String
  status        String    @default("PENDING") // PENDING | CONFIRMED | DECLINED
  invitedAt     DateTime? // last outreach email sent
  respondedAt   DateTime?
  notes         String? // instructor free-text (availability caveats, decline reason)
  responseToken String    @unique @default(cuid()) // tokenized no-login response link
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cohort     Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  instructor User   @relation("CohortInstructorRecords", fields: [instructorId], references: [id], onDelete: Cascade)

  sessionResponses CohortSessionInstructorResponse[]
  outreachSends    InstructorOutreachSend[]
  assignments      SessionAssignment[]
  reminderSends    InstructorReminderSend[]

  @@unique([cohortId, instructorId])
  @@index([instructorId])
  @@index([status])
}

model CohortSessionInstructorResponse {
  id                 String   @id @default(cuid())
  cohortInstructorId String
  sessionId          String
  availability       String   @default("UNKNOWN") // AVAILABLE | UNAVAILABLE | TENTATIVE | UNKNOWN
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cohortInstructor CohortInstructor @relation(fields: [cohortInstructorId], references: [id], onDelete: Cascade)
  session          CohortSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([cohortInstructorId, sessionId])
}

// v2: the negotiation record for one instructor teaching one session. Supersedes
// CohortSessionInstructorResponse (kept for v1 back-compat; backfilled into this).
//
// State machine — counter-offers never touch the real CohortSession until an admin
// accepts, and Google Calendar sync fires only on CONFIRMED:
//   PROPOSED ──accept──> ACCEPTED ──admin/auto──> CONFIRMED
//   PROPOSED ──request change──> CHANGE_REQUESTED ──admin accepts──> (session moved) CONFIRMED
//                                               └──admin counters──> COUNTERED ──> PROPOSED
//   any ──> DECLINED
model SessionAssignment {
  id                 String    @id @default(cuid())
  cohortInstructorId String
  sessionId          String
  status             String    @default("PROPOSED") // PROPOSED | ACCEPTED | CHANGE_REQUESTED | COUNTERED | DECLINED | CONFIRMED
  note               String? // instructor free text
  adminNote          String? // admin's counter/response text
  proposedDate       DateTime? // instructor's requested alternative
  proposedStartTime  String? // wall-clock in the session's timezone, e.g. "6:00 PM"
  proposedEndTime    String?
  respondedAt        DateTime?
  confirmedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  cohortInstructor CohortInstructor @relation(fields: [cohortInstructorId], references: [id], onDelete: Cascade)
  session          CohortSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([cohortInstructorId, sessionId])
  @@index([status])
  @@index([sessionId])
}

// Idempotency ledger for automated instructor mail (mirrors DripSend's unique-row
// model). sessionId defaults to "" rather than null so the unique index actually
// dedupes cohort-level nudges — SQLite treats NULLs as distinct.
model InstructorReminderSend {
  id                 String   @id @default(cuid())
  cohortInstructorId String
  kind               String // PROPOSAL_NUDGE_1 | PROPOSAL_NUDGE_2 | SESSION_T72 | SESSION_T24
  sessionId          String   @default("")
  status             String // SENT | FAILED | SKIPPED
  error              String?
  sentAt             DateTime @default(now())

  cohortInstructor CohortInstructor @relation(fields: [cohortInstructorId], references: [id], onDelete: Cascade)

  @@unique([cohortInstructorId, kind, sessionId])
  @@index([kind])
}

// Per-cycle outreach email (DRAFT → APPROVED → SENT). Approval is the human gate;
// sends are recorded in InstructorOutreachSend and deduped in code (24h window).
model InstructorOutreach {
  id         String    @id @default(cuid())
  cohortId   String
  subject    String
  body       String // HTML fragment; merge tokens {{first_name}} {{cohort_title}} {{cohort_dates}} {{sessions_html}} {{respond_url}}
  status     String    @default("DRAFT") // DRAFT | APPROVED | SENT
  approvedAt DateTime?
  sentAt     DateTime?
  createdBy  String? // "mcp" | admin user id
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  cohort Cohort                   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  sends  InstructorOutreachSend[]

  @@index([cohortId])
}

model InstructorOutreachSend {
  id                 String   @id @default(cuid())
  outreachId         String
  cohortInstructorId String
  status             String // SENT | FAILED | SKIPPED
  error              String?
  sentAt             DateTime @default(now())

  outreach         InstructorOutreach @relation(fields: [outreachId], references: [id], onDelete: Cascade)
  cohortInstructor CohortInstructor   @relation(fields: [cohortInstructorId], references: [id], onDelete: Cascade)

  @@index([outreachId])
  @@index([cohortInstructorId])
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  cohortId    String
  source      String   @default("native") // native | luma | manual | stripe | free
  status      String   @default("active") // active | completed | dropped
  attribution String?  // JSON: first-touch UTM params + ad click ids at purchase
  segment     String?  // onboarding segment/tag carried into checkout
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
}

// ─── Payments (Stripe Checkout) ─────────────────────────────────────
// One row per Stripe Checkout Session. The webhook is the source of truth:
// `checkout.session.completed` marks a Payment `paid` and grants the seat;
// `charge.refunded` marks it `refunded`. Amounts are stored in the smallest
// currency unit (cents), matching Stripe's representation exactly.
model Payment {
  id                    String   @id @default(cuid())
  userId                String?  // null while a guest Checkout Session is pending
  cohortId              String?
  groupId               String? // which seat tier they bought (nullable if group deleted)
  venueEventId          String?
  programId             String? // purchased program (nullable if program deleted)
  buyerEmail            String? // normalized guest/login email used to reconcile the webhook
  buyerName             String?
  attribution           String? // JSON: first-touch UTM params + ad click ids at checkout
  segment               String? // onboarding segment/tag at checkout
  stripeSessionId       String?  @unique // Checkout Session id (cs_...); null for venue rental placeholders until the webhook reconciles the paid session
  stripePaymentLinkId   String? // Payment Link id (plink_...) for venue rental links; reconciles link-created payments to their pending row
  stripePaymentIntentId String?  @unique // PaymentIntent id (pi_...), set once payment succeeds
  amount                Int // charged amount in cents
  currency              String   @default("usd")
  status                String   @default("pending") // pending | paid | failed | refunded
  expiresAt             DateTime? // pending seat reservation expiry
  checkoutUrl           String? // Stripe-hosted session URL; replaced by the after_expiration recovery URL once the session expires
  recoveredAt           DateTime? // set when a previously-expired checkout is completed via Stripe's recovery flow
  couponCode            String? // hub Coupon.code pre-applied at checkout (denormalized for reporting)
  accountSetupSentAt    DateTime? // prevents duplicate setup email on webhook retries
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  cohort     Cohort?     @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  group      Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  venueEvent VenueEvent? @relation(fields: [venueEventId], references: [id], onDelete: SetNull)
  program    Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  redemption Redemption?

  @@index([userId])
  @@index([buyerEmail])
  @@index([cohortId])
  @@index([venueEventId])
  @@index([programId])
  @@index([stripePaymentLinkId])
  @@index([status])
}

// Recurring membership subscription — entitlement to member-only content.
// Mirrors Payment: created `pending` at checkout, and
// the signature-verified Stripe webhook is the ONLY path that activates it.
model Membership {
  id                   String    @id @default(cuid())
  userId               String? // null while a guest subscription Checkout is pending
  buyerEmail           String? // normalized email used to reconcile the webhook
  buyerName            String?
  attribution          String? // JSON: first-touch UTM params + ad click ids at checkout
  segment              String? // onboarding segment/tag at checkout
  stripeSessionId      String    @unique // Checkout Session id (cs_...)
  stripeSubscriptionId String?   @unique // Subscription id (sub_...), set once active
  stripeCustomerId     String? // Stripe Customer id
  amount               Int // recurring amount in cents (for example, 5000 = $50/mo)
  currency             String    @default("usd")
  tier                 String    @default("MENTOR_NETWORK") // MENTOR_NETWORK | ACCELERATOR
  status               String    @default("pending") // pending | active | past_due | canceled | expired
  currentPeriodEnd     DateTime? // when the current paid period ends
  expiresAt            DateTime? // pending-checkout TTL, mirrors Payment.expiresAt
  checkoutUrl          String? // Stripe-hosted session URL for recovery emails
  couponCode           String? // hub Coupon.code pre-applied at checkout
  accountSetupSentAt   DateTime? // prevents duplicate setup email on webhook retries
  welcomeSentAt        DateTime? // prevents duplicate membership welcome email on webhook retries
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  redemption Redemption?

  @@index([userId])
  @@index([buyerEmail])
  @@index([status])
}

// ── Coupons & referrals ─────────────────────────────────────────────────────
// Hub-side source of truth for discounts, mirrored to Stripe (Coupon +
// Promotion Code created on activation, ids stored here). Stripe does the
// price math at checkout; the hub owns applicability, redemption tracking,
// and (for AFFILIATE codes) ownership + commission ledger. One code per
// payment is enforced by Redemption.paymentId being unique.
model Coupon {
  id                    String    @id @default(cuid())
  code                  String    @unique // stored UPPERCASE, alnum + dashes
  kind                  String // MANUAL | CAMPAIGN | AFFILIATE
  percentOff            Int? // exactly one of percentOff/amountOff is set
  amountOff             Int? // cents
  appliesTo             String    @default("all") // all | cohort | membership
  cohortId              String? // optional narrowing to a single cohort
  maxRedemptions        Int?
  expiresAt             DateTime?
  active                Boolean   @default(true)
  ownerUserId           String? // affiliate owner (ambassador program)
  commissionPercent     Int? // % of the paid amount owed to the owner; null for non-affiliate
  stripeCouponId        String?   @unique
  stripePromotionCodeId String?   @unique
  note                  String? // INTERNAL ONLY — why this code exists
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  owner       User?        @relation("CouponOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  redemptions Redemption[]

  @@index([ownerUserId])
  @@index([kind, active])
}

// One row per completed checkout that used a coupon. Written by the Stripe
// webhook (the source of truth for money) from the session's discount totals.
model Redemption {
  id               String   @id @default(cuid())
  couponId         String
  paymentId        String?  @unique // one code per payment
  membershipId     String?  @unique
  buyerEmail       String
  amountOff        Int // cents actually discounted, from Stripe's totals
  commission       Int? // cents owed to the coupon owner (affiliate)
  commissionStatus String? // pending | approved | paid_out | voided
  createdAt        DateTime @default(now())

  coupon     Coupon      @relation(fields: [couponId], references: [id], onDelete: Cascade)
  payment    Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([buyerEmail])
}

// ── Members area (Accelerator) ──────────────────────────────────────────────
// Pods are accountability groups of 4-6 Accelerator members; each maps to a
// private RocketChat group. Membership entitlements live in src/lib/entitlements.ts.

model Pod {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  status            String   @default("forming") // forming | active | archived
  capacity          Int      @default(6)
  cohortId          String? // optional: the cohort this pod's members graduated from
  rocketchatGroupId String?  @unique
  coachId           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  coach   User?       @relation("PodCoach", fields: [coachId], references: [id], onDelete: SetNull)
  cohort  Cohort?     @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  members PodMember[]
  events  MemberEvent[]

  @@index([status])
}

model PodMember {
  id       String    @id @default(cuid())
  podId    String
  userId   String
  role     String    @default("member") // member | lead
  joinedAt DateTime  @default(now())
  leftAt   DateTime? // set instead of deleting, so pod history survives

  pod  Pod  @relation(fields: [podId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([podId, userId])
  @@index([userId])
}

// The Milestone Ladder — seeded rungs (prisma/seed.ts); achievements are
// self-reported (pending) then verified by a coach/admin.
model Milestone {
  id          String @id @default(cuid())
  key         String @unique // first-conversation | first-pilot | first-testimonial | first-retainer | mrr-5k | mrr-10k
  title       String
  description String?
  order       Int

  achievements MilestoneAchievement[]
}

model MilestoneAchievement {
  id           String   @id @default(cuid())
  userId       String
  milestoneId  String
  achievedAt   DateTime @default(now())
  evidenceUrl  String?
  note         String?
  status       String   @default("pending") // pending | verified
  verifiedById String? // null = self-reported, awaiting verification

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone  Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  verifiedBy User?     @relation("MilestoneVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([userId, milestoneId])
  @@index([status])
}

// Member calls (weekly coaching, deal desk, monthly build sprint, weekly Q&A).
// Shape mirrors CohortSession for UI reuse, but deliberately NOT that model —
// CohortSession is cohort-scoped with Zoom-occurrence sync semantics.
model MemberEvent {
  id            String   @id @default(cuid())
  type          String // COACHING | DEAL_DESK | BUILD_SPRINT | WEEKLY_QA
  title         String
  description   String?
  date          DateTime
  startTime     String // "18:00"
  endTime       String // "19:00"
  timezone      String   @default("PT")
  meetingLink   String?
  recordingLink String?
  minTier       String   @default("MENTOR_NETWORK") // MENTOR_NETWORK | ACCELERATOR
  podId         String? // pod-scoped call; null = all eligible members
  status        String   @default("upcoming") // upcoming | live | completed | canceled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pod Pod? @relation(fields: [podId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([type])
}

// The member template/workflow library.
model MemberResource {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String // template | workflow | doc | video | link
  url         String
  category    String?
  minTier     String   @default("ACCELERATOR") // MENTOR_NETWORK | ACCELERATOR
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, minTier])
}

model Program {
  id          String   @id @default(cuid())
  name        String
  description String?
  cover       String? // URL to cover image
  status      String   @default("draft") // draft | open | archived | raw
  locked      Boolean  @default(false)
  priceCents  Int? // null = not sellable; one-time amount in cents via inline Stripe price_data
  includesWeeklyCalls Boolean @default(false) // a later gate lets purchasers see WEEKLY_QA member events
  // cohort (default) | direct | auth | public | member
  // Access sources are ADDITIVE: a real grant (cohort enrollment, or a staff-issued
  // ProgramAccess row) is honoured under cohort/direct/member, and accessMode only
  // widens the audience on top of it — cohort ⊂ direct ⊂ member. So a course can be
  // both a members product and a cohort's curriculum without locking either out.
  // Only "public" and "auth" are self-enrollable — see SELF_ENROLL_MODES in
  // src/lib/programAccess.ts. The rest require a real grant.
  accessMode  String   @default("cohort")
  memberMinTier String? // when accessMode = "member": minimum tier (MENTOR_NETWORK | ACCELERATOR); null = any active membership
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
  cohorts     Cohort[]
  rawCohort   Cohort?  @relation("CohortRawProgram") 
  reviews     CourseReview[]
  enrollments ProgramEnrollment[]
  accessList  ProgramAccess[]
  payments    Payment[]
  materials   ProgramMaterial[]

  @@unique([id, name])
}

model ProgramMaterial {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  title     String
  type      String   // pdf | link | document
  url       String
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
}

model ProgramAccess {
  id        String   @id @default(cuid())
  programId String
  userId    String
  createdAt DateTime @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([programId])
  @@index([userId])
}

model ProgramEnrollment {
  id        String   @id @default(cuid())
  userId    String
  programId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
}

model Module {
  id          String   @id @default(cuid())
  programId   String
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program     Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  assessments Assessment[]

  @@unique([programId, name])
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  name        String
  duration    Int      @default(0) // in seconds
  type        String   @default("text") // text | video
  text        String? // Long text with formatting
  videoUrl    String? // Link to video or path to uploaded file
  posterUrl   String? // Link to poster image or path to uploaded file
  intro       String? // Brief introduction / description
  timecodes   String? // Timecodes (e.g. "00:00 Intro\n01:30 Topic 1")
  tags        String? // Comma-separated tags
  order       Int      @default(0)
  audioUrl    String?
  captionsUrl String?
  dataUrl     String?
  zoomFileId  String?  @unique // Zoom recording ID to prevent duplicate uploads
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module            Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress          LessonProgress[]
  quiz              Quiz?
  videos            LessonVideo[]
  learningPathItems LearningPathItem[]

  @@unique([moduleId, name])
}

model LessonVideo {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  language  String   // ISO 639-1, e.g. "en", "ru"
  videoUrl  String   // same bare-GCS-key convention as Lesson.videoUrl
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, language])
  @@index([lessonId])
}

model Quiz {
  id          String   @id @default(cuid())
  lessonId    String   @unique
  name        String?
  maxAttempts Int? // null = unlimited
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  items       QuizItem[]
  submissions QuizSubmission[]
}

model QuizItem {
  id           String   @id @default(cuid())
  quizId       String
  questionText String
  type         String   @default("single_choice") // single_choice | multiple_choice | free_text
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]
}

model QuizOption {
  id        String  @id @default(cuid())
  itemId    String
  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  item       QuizItem             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  selectedIn QuizSelectedOption[]
}

model QuizSubmission {
  id            String   @id @default(cuid())
  quizId        String
  userId        String
  attemptNumber Int      @default(1)
  totalScore    Float?
  status        String   @default("submitted") // submitted | graded
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([quizId, userId, attemptNumber])
}

model QuizAnswer {
  id           String  @id @default(cuid())
  submissionId String
  itemId       String
  textAnswer   String? // for free_text
  points       Float?

  submission      QuizSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  item            QuizItem             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  selectedOptions QuizSelectedOption[]
}

model QuizSelectedOption {
  answerId String
  optionId String

  answer QuizAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option QuizOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([answerId, optionId])
}

model Assessment {
  id        String   @id @default(cuid())
  moduleId  String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module      Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  items       AssessmentItem[]
  submissions AssessmentSubmission[]
}

model AssessmentItem {
  id           String   @id @default(cuid())
  assessmentId String
  title        String?
  questionText String
  type         String   @default("single_choice") // multiple_choice | single_choice | free_text
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options    AssessmentOption[]
  answers    AssessmentAnswer[]
}

model AssessmentOption {
  id        String  @id @default(cuid())
  itemId    String
  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  item       AssessmentItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  selectedIn SelectedOption[]
}

model AssessmentSubmission {
  id           String   @id @default(cuid())
  assessmentId String
  userId       String
  cohortId     String?
  status       String   @default("submitted") // submitted | graded
  totalScore   Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort     Cohort?            @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  answers    AssessmentAnswer[]
}

model AssessmentAnswer {
  id           String  @id @default(cuid())
  submissionId String
  itemId       String
  textAnswer   String? // For free_text
  points       Float? // Points awarded for this answer

  submission      AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  item            AssessmentItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  selectedOptions SelectedOption[]
}

model SelectedOption {
  answerId String
  optionId String

  answer AssessmentAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option AssessmentOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([answerId, optionId])
}

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  cohortId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, cohortId])
}

model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  programId String
  rating    Int // 1-5
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
}

model InstructorSlot {
  id           String   @id @default(cuid())
  groupId      String
  instructorId String
  date         DateTime
  startTime    String // e.g. "10:00 AM"
  endTime      String // e.g. "11:00 AM"
  timezone     String   @default("UTC")
  isBooked     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group      Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  instructor User             @relation("InstructorSlots", fields: [instructorId], references: [id], onDelete: Cascade)
  booking    OneOnOneBooking?

  @@index([groupId])
  @@index([instructorId])
}

model OneOnOneBooking {
  id             String   @id @default(cuid())
  slotId         String   @unique
  studentId      String
  instructorId   String
  groupId        String
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  meetingLink    String?
  studentNote    String?
  instructorNote String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  slot       InstructorSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  student    User           @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  instructor User           @relation("InstructorBookings", fields: [instructorId], references: [id], onDelete: Cascade)
  group      Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([instructorId])
  @@index([groupId])
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   MediaFolder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("SubFolders")
  media    Media[]
}

model Media {
  id           String   @id @default(cuid())
  name         String
  url          String
  type         String // image | video | document | other
  size         Int? // bytes
  folderId     String?
  downloadable Boolean  @default(false)
  description  String?
  thumbnailUrl String?  // URL to preview PNG (for PDFs generated server-side)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  folder           MediaFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
}


// ─── Onboarding Models ──────────────────────────────────────────────────────
model OnboardingForm {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String?
  ghlFieldMapping String? // JSON: { firstName?, lastName?, contactName?, phone?, email? } element ids
  aiPrompt        String?
  // Navigation is intentionally separate from tags. One single-choice element
  // may determine the destination; the form URL is used when it has no URL.
  routingElementId   String?
  defaultRedirectUrl String?
  createdAt          DateTime @default(now())
  updatedAt       DateTime @updatedAt

  steps          OnboardingStep[]
  routingElement OnboardingElement?    @relation("OnboardingRoutingElement", fields: [routingElementId], references: [id], onDelete: SetNull)
  tagMappings    OnboardingTagCohort[]
  responses      OnboardingResponse[]
}

model OnboardingStep {
  id     String @id @default(cuid())
  formId String
  title  String
  slug   String?
  order  Int    @default(0)

  form            OnboardingForm      @relation(fields: [formId], references: [id], onDelete: Cascade)
  elements        OnboardingElement[]
  incomingOptions OnboardingOption[]  @relation("OptionNextStep")

  @@unique([formId, slug])
}

model OnboardingElement {
  id       String  @id @default(cuid())
  stepId   String
  type     String // multiple_choice | single_choice | text_single | text_multi | phone
  label    String
  required Boolean @default(false)
  order    Int     @default(0)

  step            OnboardingStep   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  routingForForms OnboardingForm[] @relation("OnboardingRoutingElement")
  options         OnboardingOption[]
}

model OnboardingOption {
  id         String  @id @default(cuid())
  elementId  String
  text       String
  tag        String  @default("")
  order      Int     @default(0)
  nextStepId String?
  redirectUrl String?

  element  OnboardingElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  nextStep OnboardingStep?   @relation("OptionNextStep", fields: [nextStepId], references: [id], onDelete: SetNull)
}

model OnboardingTagCohort {
  id       String  @id @default(cuid())
  formId   String
  tag      String
  // Legacy data retained for compatibility and the admin import tool. Explicit
  // answer routing uses OnboardingForm.routingElementId + option.redirectUrl.
  cohortId String?
  url      String?

  form   OnboardingForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  cohort Cohort?        @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([formId, tag])
}

model OnboardingResponse {
  id        String   @id @default(cuid())
  formId    String
  answers   String // JSON: { elementId: string | string[] }
  tagCounts String // JSON: { tag: count }
  cohortId  String?
  status    String   @default("COMPLETED") // "PROCESSING" | "COMPLETED"
  aiResult  String?
  attribution String? // JSON: captured UTM params + ad click ids (marketing source)
  createdAt DateTime @default(now())

  form   OnboardingForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  cohort Cohort?        @relation(fields: [cohortId], references: [id], onDelete: SetNull)
}

// ─── Jobs ──────────────────────────────────────────────────────────────────
model DuplicateJob {
  id        String   @id @default(cuid())
  type      String   // "lesson" | "module" | "course"
  status    String   @default("pending") // "pending" | "running" | "done" | "failed"
  progress  Int      @default(0)         // 0-100
  message   String?
  error     String?
  resultId  String?
  resultUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Learning Path Models ──────────────────────────────────────────
model LearningPath {
  id          String   @id @default(cuid())
  title       String
  description String?
  
  cohortId    String
  cohort      Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  
  order       Int      @default(0)

  items       LearningPathItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cohortId])
}

model LearningPathItem {
  id             String       @id @default(cuid())
  
  learningPathId String
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  
  lessonId       String
  lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  order          Int          @default(0)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([learningPathId, lessonId])
  @@index([learningPathId])
  @@index([lessonId])
}


// ─── Mind Health Config ────────────────────────────────────────────
// Singleton row: stores which date's mind-health exercise is currently
// shown to students and unauthenticated visitors.
model MindHealthConfig {
  id          Int      @id @default(1) // always 1
  currentDate String   // ISO date string, e.g. "2026-06-09"
  updatedAt   DateTime @updatedAt
  updatedById String?  // who last changed it (ADMIN/INSTRUCTOR user id)

  @@map("mind_health_config")
}



model Contact {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  birthday   String? // ISO YYYY-MM-DD date-only string; timezone-safe
  userId     String?
  linkSource String? // "auto_email" | "auto_phone" | "manual"

  // Internal lead pipeline (replaces external CRM for now)
  status         String    @default("NEW") // NEW | CONTACTED | QUALIFIED | WON | LOST
  excludeFromPipeline Boolean @default(false)
  source         String? // where the lead came from, e.g. "onboarding:ai-path", "asset_download", "manual"
  attribution    String? // JSON: first-touch UTM params + ad click ids
  tags           String? // JSON string[]: qualifiers (e.g. quiz tags like goal-agency, fit-evening)
  notes          String? // free-form internal notes
  lastActivityAt DateTime?

  // Cached AI brief for the lead profile (JSON: summary / engagement / nextAction).
  // Generated on demand only — never on page load, which would put an LLM call and
  // its cost in the path of simply opening a record.
  aiBrief   String?
  aiBriefAt DateTime?

  // Drip / outreach email consent, two scopes (see src/lib/drip/emailScope.ts).
  // A non-null unsubscribedAt is the MARKETING opt-out: it suppresses nurture,
  // broadcast and outreach mail. courseEmailOptOutAt is the COURSE opt-out: it
  // suppresses course updates (cohort reminders, cohort messages, certificate
  // notices). Neither affects transactional mail (receipts, password resets).
  // The token is the one-click link secret for both scopes.
  unsubscribedAt      DateTime?
  courseEmailOptOutAt DateTime?
  unsubscribeToken    String?   @unique
  publicToken         String?   @unique // lazily minted for public booking links
  /// When the student last dismissed the cohort-page "get updates" banner; it
  /// stays hidden for 7 days after this.
  cohortBannerDismissedAt DateTime?

  /// Consent to phone calls only, including calls placed by an automated/AI assistant.
  phoneConsentAt            DateTime?
  smsMarketingConsentAt     DateTime?
  smsTransactionalConsentAt DateTime?
  /// `doNotCall` blocks automated calls. `smsOptOutAt` blocks all SMS, is set by
  /// inbound STOP, and is cleared by inbound START.
  doNotCall   Boolean   @default(false)
  smsOptOutAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events          ContactEvent[]
  dripEnrollments DripEnrollment[]
  emailEvents     EmailEvent[]
  dripSends       DripSend[]
  contactNotes    ContactNote[]
  calls           ContactCall[]
  messages        ContactMessage[]
  venueEvents     VenueEvent[]
  venueEventRegistrations VenueEventRegistration[]
  bookings        LeadBooking[]

  @@index([status])
  @@index([unsubscribedAt])
  @@index([userId])
}

model CloserSlot {
  id        String   @id @default(cuid())
  closerId  String
  startAt   DateTime
  endAt     DateTime
  timezone  String
  createdAt DateTime @default(now())

