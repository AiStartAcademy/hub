  @@index([feature, createdAt])
  @@index([model, createdAt])
}

// Integrations registry — admin-managed secrets & config (see docs/features/INTEGRATIONS.md).
// `secret` kind is AES-256-GCM encrypted at rest; `config` kind is plaintext (URLs/flags).
model Secret {
  id             String   @id @default(cuid())
  key            String   @unique // e.g. "HUB_MCP_TOKEN", "OPENAI_API_KEY"
  category       String   @default("other") // "llm" | "mcp" | "payments" | "comms" | "endpoints" | "other"
  kind           String   @default("secret") // "secret" | "config"
  valueEncrypted String? // secret kind: base64 ciphertext
  iv             String? // GCM iv (base64)
  authTag        String? // GCM auth tag (base64)
  valuePlain     String? // config kind only
  last4          String? // secret kind: last 4 chars for identification
  description    String?
  updatedBy      String? // User.id
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([category])
}

// Audit trail for the integrations registry. Records WHAT changed and BY WHOM — never the value.
model SecretAudit {
  id        String   @id @default(cuid())
  key       String
  action    String // "create" | "update" | "delete"
  actorId   String?
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ─── Drip Campaigns (lead nurture) ─────────────────────────────────
// Multi-step, scheduled outreach over the internal Leads CRM.
// See docs/features/DRIP_CAMPAIGNS.md. sqlite ⇒ no enums / native JSON:
// unions live in comments, list-shaped values are JSON strings.

model DripCampaign {
  id          String  @id @default(cuid())
  slug        String  @unique // stable key used by seeds + auto-enroll
  name        String
  description String?

  status String @default("DRAFT") // DRAFT | ACTIVE | PAUSED | ARCHIVED

  // What starts the sequence. LEAD_SEGMENT = classic lead-nurture (segment rule
  // below). COHORT_SCHEDULE = cohort pre-start reminders: enrollment is driven
  // by cohort registration (paid Enrollment rows + free registrants), steps may
  // anchor to the cohort's start instant, and the segment rule is ignored.
  trigger String @default("LEAD_SEGMENT") // LEAD_SEGMENT | COHORT_SCHEDULE | BROADCAST | CERTIFICATE_ISSUED | COHORT_MESSAGE

  // Audience rule. JSON DripSegment — see src/lib/drip/segment.ts:
  // { sources?, statuses?, anyTags?, allTags?, noneTags?, minAgeHours?,
  //   maxAgeDays?, inactiveForDays? }
  segment String @default("{}")

  // Enrollment behaviour
  autoEnroll     Boolean @default(true)
  exitOnStatuses String  @default("[\"WON\",\"LOST\"]") // JSON string[]: leaving = campaign exit
  priority       Int     @default(100) // lower wins when a lead matches several campaigns

  // Send window, evaluated in `timezone`. Steps due outside it are deferred,
  // never dropped — nobody gets a 3am cold email.
  timezone             String  @default("America/Los_Angeles")
  sendWindowStartHour  Int     @default(8)  // inclusive, 0-23
  sendWindowEndHour    Int     @default(18) // exclusive, 1-24
  skipWeekends         Boolean @default(false)

  // Staff inbox used by the "send test" button on each step. Test sends bypass
  // enrollment, the send window and the DripSend ledger entirely — they never
  // touch a real lead and are not counted as campaign sends.
  testEmail String?

  // Broadcast dispatch record. Null on every campaign that has never been sent;
  // audienceSnapshot is the JSON counts recorded at send time.
  sentAt           DateTime?
  audienceSnapshot String?

  // Cohort message (trigger COHORT_MESSAGE) fields; null on every other campaign.
  // cohortId is the cohort the message was sent to. logisticsConfirmedAt records
  // when the admin confirmed the message is a logistics update, not a promotion
  // (course-scope mail reaches marketing-unsubscribed students). idempotencyKey
  // makes a double-submitted send create one campaign, not two.
  cohortId             String?
  logisticsConfirmedAt DateTime?
  idempotencyKey       String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       DripStep[]
  enrollments DripEnrollment[]

  @@index([status])
  @@index([cohortId])
}

model DripStep {
  id         String @id @default(cuid())
  campaignId String
  order      Int // 1-based position in the sequence

  // Wait after the PREVIOUS step's send (or after enrollment, for order 1).
  delayHours Int @default(24)

  // Scheduling anchor. ENROLLMENT = classic delayHours semantics. COHORT_START
  // (COHORT_SCHEDULE campaigns only) = due at cohortStart + offsetMinutes,
  // where offsetMinutes is negative for "before start" (-1440 = T-1d).
  anchor        String @default("ENROLLMENT") // ENROLLMENT | COHORT_START
  offsetMinutes Int    @default(0)

  channel String @default("EMAIL") // EMAIL | TASK | CALL | SMS (TASK = internal reminder; CALL = AI voice call via Vapi; SMS = plain-text text message)

  subject  String
  // HTML body fragment. Rendered into the branded shell by src/lib/drip/template.ts.
  // Supports {{first_name}} {{name}} {{email}} {{cta}} {{unsubscribe_url}} tokens.
  body     String
  ctaLabel String?
  ctaUrl   String?

  // CALL channel only. Override the default Vapi assistant / opening line for
  // this step; for CALL steps `subject` is just the internal step label.
  callAssistantId  String?
  callFirstMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign DripCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sends    DripSend[]

  @@unique([campaignId, order])
  @@index([campaignId])
}

model DripEnrollment {
  id         String @id @default(cuid())
  campaignId String
  contactId  String

  // Cohort this enrollment is anchored to, for COHORT_SCHEDULE campaigns.
  // Empty string (not NULL) for lead campaigns: Postgres treats NULLs as
  // distinct in unique indexes, which would silently break the "never
  // enrolled twice" guarantee below. Plain string, no FK — cohort deletion
  // must not cascade away send history; stale rows just stop resolving.
  cohortId String @default("")

  status String @default("ACTIVE") // ACTIVE | COMPLETED | EXITED | PAUSED

  // Position + schedule. lastStepOrder is what has actually been sent;
  // nextRunAt is when the next step becomes due (null once finished).
  lastStepOrder Int       @default(0)
  nextRunAt     DateTime?

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  exitedAt    DateTime?
  exitReason  String? // status_exit | unsubscribed | manual | segment_mismatch

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign DripCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sends    DripSend[]

  // A lead is never enrolled twice in one campaign (per cohort, for
  // COHORT_SCHEDULE campaigns — lead campaigns always carry cohortId "").
  @@unique([campaignId, contactId, cohortId])
  @@index([status, nextRunAt])
  @@index([contactId])
  @@index([cohortId])
}

model DripSend {
  id           String @id @default(cuid())
  enrollmentId String
  stepId       String

  // Denormalized from the enrollment so timeline and per-contact engagement reads
  // don't need a two-hop join. Nullable only because rows predate the column.
  contactId String?

  status String // SENT | FAILED | SKIPPED
  error  String?

  subject String? // snapshot of what actually went out
  sentAt  DateTime @default(now())

  // First-touch engagement rollups, so campaign stats never scan EmailEvent.
  // Opens are directional only (Apple MPP / image proxies inflate them, image
  // blocking suppresses them) — firstClickedAt is the trustworthy signal.
  openedAt       DateTime?
  firstClickedAt DateTime?

  enrollment DripEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       DripStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  contact    Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  emailEvents EmailEvent[]
  call        ContactCall?
  message     ContactMessage?

  @@unique([enrollmentId, stepId]) // idempotency: one send per step per enrollment
  @@index([sentAt])
  @@index([contactId])
}

/// One timestamped, attributed note on a lead — the CRM's notes journal.
///
/// This coexists with `Contact.notes` by design, and they are not the same thing:
/// `Contact.notes` is a single free-form scratchpad blob (still edited from the
/// leads table), while ContactNote is an append-only journal where every entry
/// knows when it was written and by whom. Drip TASK-channel steps write here
/// rather than appending machine-generated lines into the blob, which is what
/// they used to do.
model ContactNote {
  id        String @id @default(cuid())
  contactId String

  body String

  /// Staff User.id, or null for system/automation-generated notes.
  authorId String?
  /// Display name snapshot ("Lex", "Drip: Qualified → Close", "System"), so a
  /// note still reads correctly after an account is renamed or removed.
  authorLabel String

  /// MANUAL | DRIP_TASK | SYSTEM
  kind String @default("MANUAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
}

/// One phone call with a lead — AI-placed (Vapi), browser-placed (Twilio), or human-logged ("manual").
///
/// Rows are created at initiation (status INITIATED) and finalized asynchronously
/// by the Vapi end-of-call-report webhook, which fills transcript / recording /
/// analysis. Manual calls are logged post-hoc by staff from the lead profile.
/// dripSendId links a call back to the drip step that placed it (null for
/// one-off calls from the profile button or human-logged calls).
model ContactCall {
  id         String  @id @default(cuid())
  contactId  String
  dripSendId String? @unique

  provider       String  @default("vapi") // vapi | manual | twilio
  providerCallId String? @unique
  direction      String  @default("OUTBOUND") // OUTBOUND | INBOUND

  // INITIATED | RINGING | IN_PROGRESS | COMPLETED | NO_ANSWER | VOICEMAIL | FAILED | TRANSFERRED
  status      String  @default("INITIATED")
  outcome     String? // analysis slug: qualified | not_interested | callback | ...
  endedReason String? // raw Vapi endedReason

  durationSec   Int?
  recordingUrl  String?
  transcript    String?
  summary       String?
  analysis      String? // JSON: Vapi analysisPlan structuredData
  assistantId   String?
  phoneNumber   String? // E.164 actually dialed (snapshot)
  transferredTo String? // number warm-transferred to, if any

  // Staff who clicked "Call with AI" / logged the manual call; null for drip.
  authorId    String?
  authorLabel String?

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dripSend DripSend? @relation(fields: [dripSendId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
  @@index([status])
}

model ContactMessage {
  id         String  @id @default(cuid())
  contactId  String
  dripSendId String? @unique

  provider    String  @default("twilio")
  providerSid String? @unique
  direction   String  @default("OUTBOUND") // OUTBOUND | INBOUND
  status      String  @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED | RECEIVED

  body        String
  fromNumber  String
  toNumber    String
  error       String?
  authorId    String?
  authorLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dripSend DripSend? @relation(fields: [dripSendId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
}

/// Provider-agnostic record of everything observable about an outbound email.
///
/// Our own pixel + click redirect write OPENED/CLICKED here today; if we ever move
/// off raw SMTP to a provider (Resend/SES), its webhooks write DELIVERED/BOUNCED/
/// COMPLAINED into the same table without a rebuild. Those three values are defined
/// but never written today — raw SMTP gives us no delivery feedback at all.
model EmailEvent {
  id         String  @id @default(cuid())
  contactId  String
  dripSendId String? // null for transactional / future non-drip mail

  // SENT | FAILED | OPENED | CLICKED | UNSUBSCRIBED | DELIVERED | BOUNCED | COMPLAINED
  // (String, not enum — SQLite has no enum type; matches the rest of this schema.)
  type String

  url       String? // CLICKED only: the destination that was followed
  subject   String? // snapshot, so a timeline row reads standalone
  bodyHtml  String? // SENT rows only: the rendered fragment the recipient received
  userAgent String?
  ipHash    String? // salted sha256, truncated — a raw IP is never stored
  source    String  @default("hub") // "hub" | future provider name
  metadata  String? // JSON, matching the ContactEvent convention

  createdAt DateTime @default(now())

  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dripSend DripSend? @relation(fields: [dripSendId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
  @@index([dripSendId, type])
}
