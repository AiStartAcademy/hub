  contactId String
  
  type                 String  // "ASSET_DOWNLOAD" | "LESSON_VIEW" | "ONBOARDING" | "NEWSLETTER_SUBSCRIBE" | "VENUE_EVENT_REGISTER" | "MANUAL"
  onboardingResponseId String? @unique // idempotency key for onboarding → lead sync
  
