model VenueEvent {
  id                      String   @id @default(cuid())
  title                   String
  slug                    String   @unique
  type                    String   @default("OTHER") // NETWORKING | HACKATHON | WORKSHOP | MEETUP | INTERVIEW | PODCAST | PANEL | DEMO_DAY | KIDS_PROGRAM | MOVIE_CLUB | OTHER
  description             String?
  organizerName           String
  orgName                 String?
  contactEmail            String
  contactPhone            String?
  date                    DateTime
  startTime               String // e.g. "10:00 AM"
  endTime                 String // e.g. "12:00 PM"
  timezone                String   @default("America/Los_Angeles")
  expectedAttendees       Int?
  capacity                Int?
  status                  String   @default("PENDING") // PENDING | APPROVED | DECLINED | CANCELLED
  dealType                String   @default("PAID_RENTAL") // PAID_RENTAL | BARTER | REVENUE_SHARE | FREE_PROMO | INTERNAL
  // Future `dealStage` will map the venue booking-ledger statuses (quoted / deposit-paid / confirmed).
  dealNote                String? // INTERNAL ONLY — never serialized publicly
  adminNote               String? // INTERNAL ONLY
  quoteAmountCents        Int? // INTERNAL ONLY
  quoteNote               String? // INTERNAL ONLY
  rentalFeeCents          Int? // INTERNAL ONLY
  rentalDepositCents      Int? // INTERNAL ONLY
  rentalPaymentLinkId     String? // INTERNAL ONLY
  rentalPaymentUrl        String? // INTERNAL ONLY
  rentalPaymentStatus     String? // pending | paid | refunded — denormalized from Payment for drawer display
  cover                   String?
  externalRegistrationUrl String?
  ticketPriceCents        Int?
  ticketPaymentLink       String?
  // ─── Public landing-page content ─────────────────────────────────
  // SQLite has no scalar lists, so the multi-value fields are JSON strings —
  // same convention as ContentPage.videos/faq/sections. Never read them raw:
  // everything goes through src/lib/venueEventContent.ts, which returns [] on
  // malformed JSON so a hand-edited row can't render [object Object] publicly.
  endDate                 DateTime? // multi-day events; null = single-day. Same date-only UTC-midnight convention as `date`.
  subtitle                String? // one-line lede under the title
  videoUrl                String? // canonical video (YouTube watch/youtu.be/shorts/embed URL)
  priceNote               String? // free text under the price, e.g. "Early bird until Aug 31"
  gallery                 String? // JSON: [{ url, alt?, caption? }]
  agenda                  String? // JSON: [{ date?, label?, startTime?, endTime?, title, note?, isPublic? }]
  hosts                   String? // JSON: [{ name, role?, bio?, photoUrl?, profileSlug?, links? }]
  pricingTiers            String? // JSON: [{ label, priceCents, note?, url?, availableUntil?, soldOut? }]
  faq                     String? // JSON: [{ q, a }]
  isOnline                Boolean  @default(false) // true = Zoom-only, skips the in-person waiver checkbox
  source                  String   @default("FORM") // FORM | MCP | ADMIN
  gcalEventId             String?
  gcalSyncError           String?
  gcalSyncedAt            DateTime?
  contactId               String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  contact       Contact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  registrations VenueEventRegistration[]
  agreements    VenueAgreement[]
  payments      Payment[]

  @@index([date])
  @@index([status])
  @@index([status, date])
