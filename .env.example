# =============================================================================
# Hub — environment template
# =============================================================================
# This file IS committed. It documents every variable the hub reads; it holds
# NO real secrets — only placeholders.
#
#   Local dev (native `npm run dev`):  cp .env.example .env  then fill in values.
#   Production secrets go in your platform's secret store (never commit real values).
#
# `.env*` is gitignored (except this file), so real secrets are never committed.
# Full reference: docs/ENVIRONMENT.md
#
# Only the CORE group is required to boot. Every other group gates one feature
# and can be left blank locally — that feature just stays inactive.
# =============================================================================

# --- Core (required to boot) -------------------------------------------------
# SQLite path. Relative paths resolve from prisma/ (this default creates prisma/dev.db).
DATABASE_URL="file:./dev.db"
# NextAuth v5 signing secret — generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-openssl-rand-hex-32"
NEXTAUTH_SECRET="same-value-as-AUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Server-only base URL for internal callbacks (for example, cluster DNS for
# extract-audio) so backend-to-backend traffic does not rely on the public host.
# Leave blank locally unless another service must call back to a non-public URL.
HUB_INTERNAL_URL=""
NODE_ENV="development"

# --- Stripe (paid cohort seats) ----------------------------------------------
# Hosted Checkout; the hub never touches card data. Seat prices are built
# dynamically from Group.price (no Stripe product catalog). Seats are granted by
# the webhook, never on browser redirect. Use test keys (sk_test_/pk_test_) for
# development; the webhook secret differs between local CLI and deployed endpoint.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional: pre-created recurring Prices for the two membership tiers. If a tier's
# var is unset, the membership checkout builds that tier's price inline
# (currency/amount/interval); amounts come from content.membershipTiers.
STRIPE_MEMBERSHIP_RECORDINGS_PRICE_ID="price_..."
STRIPE_MEMBERSHIP_ACCELERATOR_PRICE_ID="price_..."

# --- Google OAuth (login) — optional locally (use email/password instead) -----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# --- Google Cloud Storage (media) — optional; uploads fail without it ---------
GCS_PROJECT_ID=""
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""
GCS_BUCKET_NAME=""
NEXT_PUBLIC_GCS_BUCKET_NAME=""

# --- Google Drive (import) — optional -----------------------------------------
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
NEXT_PUBLIC_GOOGLE_API_KEY=""

# --- GoHighLevel CRM (onboarding leads) — optional; currently dormant ---------
GHL_API_KEY=""
GHL_LOCATION_ID=""
GHL_UTM_SOURCE_ID=""
GHL_UTM_MEDIUM_ID=""
GHL_UTM_CAMPAIGN_ID=""
GHL_UTM_CONTENT_ID=""

# --- Zoom (cohort sessions) — optional ----------------------------------------
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_WEBHOOK_SECRET=""

# --- RocketChat (cohort chat) — optional --------------------------------------
RC_URL=""
RC_ADMIN_USER_ID=""
RC_ADMIN_AUTH_TOKEN=""
RC_PASSWORD_SECRET=""

# --- Email (SMTP) — optional --------------------------------------------------
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
REPORT_ISSUE_EMAIL=""
# Drip/instructor sender overrides. Legacy AISA_FROM / AISA_REPLY_TO remain
# supported as deprecated aliases; prefer the neutral names for new installs.
DRIP_FROM=""
DRIP_REPLY_TO=""
AISA_FROM=""
AISA_REPLY_TO=""

# --- n8n (automation webhooks) — optional -------------------------------------
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""
N8N_CALLBACK_SECRET=""

# --- Server-side conversions (GA4 + Meta CAPI) — optional ---------------------
# Reports generate_lead / purchase straight from the server, so conversions
# survive ad blockers, iOS ITP, and a closed tab. See src/lib/serverConversions.ts.
# Each destination is independent: leave a pair blank and only that one goes quiet.
# GTM deliberately does NOT tag these two events — it would double-count, since
# GA4 only auto-dedupes `purchase`. GTM owns begin_checkout only.
#
# All five keys below are admin-manageable at Settings → Integrations (DB Secret
# registry, resolved via getSecret with these env vars as the fallback floor) —
# prefer setting them there: no redeploy, and META_PIXEL_ID also drives the
# browser pixel via /api/meta-pixel.
#
# GA4_API_SECRET: GA4 Admin → Data Streams → (the hub stream) → Measurement
#   Protocol API secrets → Create. Not the same as the measurement ID.
GA4_MEASUREMENT_ID=""   # e.g. G-XXXXXXXXXX (your GA4 web stream)
GA4_API_SECRET=""
# META_CAPI_TOKEN: Meta Events Manager → Data sources → (pixel) → Settings →
#   Conversions API → Generate access token.
META_PIXEL_ID=""
META_CAPI_TOKEN=""
# Optional: routes events to Events Manager → Test Events instead of live
# reporting, so you can watch them arrive before trusting the pipe. Leave blank
# in production — set, it keeps events OUT of normal reporting.
META_TEST_EVENT_CODE=""

# --- Drip runner (internal cron) — optional -----------------------------------
# Dedicated bearer for /api/internal/drip/tick. Callers send it as:
#   Authorization: Bearer $DRIP_CRON_TOKEN
DRIP_CRON_TOKEN=""
# HMAC key for open-pixel / click-redirect tokens (src/lib/drip/tracking.ts).
# Unset = drip mail sends untracked, which is a safe degrade, not an error.
# Rotating it invalidates tracking links in already-delivered mail.
DRIP_TRACKING_SECRET=""
# Optional separate salt for hashed IPs on tracking events. Falls back to
# DRIP_TRACKING_SECRET. Raw IPs are never stored.
DRIP_TRACKING_SALT=""

# --- SMS (Twilio) — optional ------------------------------------------------
# Master switch for transactional SMS steps in cohort messages. Off (blank)
# until Twilio approves the A2P campaign; when off, cohort messages go out as
# email only. Admins can also set it in Settings → Integrations (managed
# secret wins over env).
SMS_TRANSACTIONAL_ENABLED=""

# --- Hub MCP (owner-operated control plane) — optional ------------------------
# Dedicated bearer shared only with hub-mcp. Generate a separate random
# value; never reuse another service token. Missing token fails all MCP routes.
HUB_MCP_TOKEN=""
# Authoritative write switch. Existing DRAFT-only connector accepts only "true";
# missing or any other value blocks writes. Read endpoints remain available.
HUB_MCP_WRITES_ENABLED="false"
# Returned by the MCP health endpoint and shown to the operator.
HUB_ENV="development"

# --- AI (onboarding analysis / image generation) — optional -------------------
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""

# -----------------------------------------------------------------------------
# Brand / catalog overrides (optional). Unset = upstream defaults in
# src/config/catalog.ts and src/components/FaroProvider.tsx.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SELF_PACED_PROGRAM_ID=
NEXT_PUBLIC_QA_EVENT_COHORT_ID=
NEXT_PUBLIC_GTM_ID=
# Public hub hostname for the docker-compose Caddy proxy (required by compose).
HUB_DOMAIN=
